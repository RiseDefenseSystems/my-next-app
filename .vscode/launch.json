{
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Run eslint",
            "runtimeExecutable": "eslint",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "Containers: Node.js Launch",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "platform": "node",
            "node": {
                "package": "${workspaceFolder}/.next/dev/build/package.json",
                "localRoot": "${workspaceFolder}/.next/dev/build"
            }
        }
    ]
